# ==========================
# Font
# ==========================
# JetBrainsMono Nerd Font (installed under ~/.local/share/fonts/JetBrainsMono).
# The "Mono" variant keeps Nerd Font icons at single-cell width so columns stay
# aligned (matters for the tmux/catppuccin status bar).
font-family = JetBrainsMono Nerd Font Mono
font-size = 11

# ==========================
# Colors — Atom One Dark
# ==========================
# Ghostty ships the palette (/usr/share/ghostty/themes/Atom One Dark). Its
# background is #21252b — Atom's *sidebar* shade. Override to #282c34, the
# editor background, so the terminal matches onedark.nvim edge-to-edge and
# there's no seam where nvim's background ends.
theme = Atom One Dark
background = #282c34
cursor-text = #282c34
selection-background = #3e4451

# Block cursor.
cursor-style = block

# ==========================
# Window
# ==========================
# Borderless, but rounded: GTK draws the window itself (client-side
# decorations) and hides only the titlebar. The rounded corners come from that
# GTK decoration, not from the compositor — "none" is borderless too, but its
# corners come out square. The window keeps its drop shadow and resize edges.
#
# With no titlebar there's no click target to drag/close the window: move via
# the WM shortcut (often Super+drag) and close by exiting the shell. Reverse by
# setting window-decoration to "none" (square) or gtk-titlebar to true.
window-decoration = client
gtk-titlebar = false

# tmux owns the multiplexing layer, so keep Ghostty's own chrome quiet.
gtk-tabs-location = hidden
gtk-single-instance = true

# Padding has to clear the rounded corners set above. At 2pt the corner arc
# cut into the first and last cells, so the ends of the tmux status bar and
# the prompt looked crowded; 6pt puts the text outside the arc. Values are in
# points, so they scale with DPI. Balance spreads the leftover partial-cell
# padding across all four edges instead of piling it on the right and bottom,
# so every corner gets the same clearance.
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
